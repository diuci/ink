{
  "name": "inkwave",
  "productName": "丢词大作战",
  "version": "1.1.0",
  "description": "丢词大作战：一款用古诗词占点的 4v4 汉字涂地射击游戏，基于 three.js。",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "python3 tools/serve.py 8490",
    "check": "for f in $(find src electron build tools server/src -name '*.js' -o -name '*.mjs' -o -name '*.cjs'); do node --check \"$f\" || exit 1; done && echo 'syntax ok'",
    "package": "electron-packager . INKWAVE --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --app-bundle-id=local.inkwave.game --app-category-type=public.app-category.action-games --extend-info=build/extend-info.plist --darwin-dark-mode-support --asar.unpackDir=songs --out=dist --overwrite --ignore='^/(dist|build|node_modules|docs|tools|server|\\.botlab)(/|$)' --ignore='\\.DS_Store$'",
    "music": "node build/music-manifest.mjs",
    "prestart": "npm run -s music",
    "prepackage": "npm run -s check && npm run -s music",
    "bake": "electron build/bake-ao.cjs",
    "check-maps": "node build/check-maps.mjs",
    "check-signs": "node tools/zh-signs.mjs --check",
    "zh-signs": "node tools/zh-signs.mjs --apply",
    "icon": "sh build/make-icon.sh",
    "botlab": "tools/botlab/run.sh tools/botlab/match.cjs",
    "smoke": "./tools/smoke.sh",
    "smoke-win": "node tools/smoke-win.mjs",
    "smoke-zones": "node tools/smoke-zones.mjs",
    "test-poems": "node tools/test-link.mjs && node tools/test-zones-flow.mjs && node tools/check-weapon-poems.mjs && node tools/check-quiz-claim.mjs && node tools/check-voice-quiz.mjs && node tools/check-quiz-modes.mjs",
    "poems-selfcheck": "node -e \"import('./src/game/poems/poems.js').then(m=>{const p=m.verifyContent();console.log(p.length?'✗ '+p.length+' 项':'✓ 内容自检通过')})\"",
    "sync-poems": "python tools/sync-poems.py",
    "net-test": "node tools/net-test.mjs",
    "build": "python3 tools/build-dist.py",
    "release": "./tools/release-pages.sh",
    "deploy-relay": "cd server && wrangler deploy",
    "relay": "cd server && wrangler dev --ip 0.0.0.0 --port 8787"
  },
  "keywords": [
    "game",
    "three.js",
    "webgl",
    "shooter",
    "splatoon",
    "turf-war",
    "browser-game"
  ],
  "author": "Jayden Davis",
  "license": "MIT",
  "type": "module",
  "homepage": "https://diuci.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaydendavisnc/inkwave.git"
  },
  "bugs": {
    "url": "https://github.com/jaydendavisnc/inkwave/issues"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "puppeteer-core": "^25.12.0",
    "wrangler": "^4.141.0"
  }
}
